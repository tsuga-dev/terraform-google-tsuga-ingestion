extensions:
  health_check:
    endpoint: "0.0.0.0:13133"
%{ if enable_logs ~}
  # Required since 0.132.0: enables decoding Cloud Logging entries from Pub/Sub.
  google_cloud_logentry_encoding: {}
%{ endif ~}

receivers:
%{ if enable_logs ~}
  googlecloudpubsub:
    project: ${project_id}
    subscription: ${subscription}
    encoding: google_cloud_logentry_encoding
    ignore_encoding_error: true
%{ if universe_domain != "" ~}
    universe_domain: ${universe_domain}
%{ endif ~}
%{ endif ~}
%{ if enable_metrics ~}
%{ for name, prefix in metric_prefixes ~}
  googlecloudmonitoring/${name}:
    project_id: ${project_id}
    collection_interval: ${collection_interval}
%{ if universe_domain != "" ~}
    universe_domain: ${universe_domain}
%{ endif ~}
    metrics_list:
      - metric_descriptor_filter: 'metric.type = starts_with("${prefix}")'
%{ endfor ~}
%{ endif ~}

processors:
%{ if length(resource_attributes) > 0 ~}
  resource:
    attributes:
%{ for key, value in resource_attributes ~}
      - key: ${jsonencode(key)}
        value: ${jsonencode(value)}
        action: upsert
%{ endfor ~}
%{ endif ~}
  resource_detection:
    detectors: [env, gcp]
  batch:
    timeout: 5s

exporters:
  otlp_http:
    endpoint: ${tsuga_intake_url}
    headers:
      Authorization: Bearer $${env:TSUGA_API_KEY}
    compression: gzip
    timeout: 30s
    retry_on_failure:
      enabled: true
      initial_interval: 1s
      max_interval: 10s
      max_elapsed_time: 10s
    sending_queue:
      enabled: true
      num_consumers: 4
      queue_size: 4096

service:
  extensions: [health_check%{ if enable_logs ~}, google_cloud_logentry_encoding%{ endif ~}]
  pipelines:
%{ if enable_logs ~}
    logs:
      receivers: [googlecloudpubsub]
      processors: [resource_detection%{ if length(resource_attributes) > 0 }, resource%{ endif }, batch]
      exporters: [otlp_http]
%{ endif ~}
%{ if enable_metrics ~}
    metrics:
      receivers: [${join(", ", [for name in keys(metric_prefixes) : "googlecloudmonitoring/${name}"])}]
      processors: [resource_detection%{ if length(resource_attributes) > 0 }, resource%{ endif }, batch]
      exporters: [otlp_http]
%{ endif ~}
  telemetry:
%{ if length(resource_attributes) > 0 ~}
    resource:
%{ for key, value in resource_attributes ~}
      ${jsonencode(key)}: ${jsonencode(value)}
%{ endfor ~}
%{ endif ~}
    logs:
      level: debug
      encoding: json
      processors:
        - batch:
            exporter:
              otlp:
                protocol: http/protobuf
                headers:
                  Authorization: Bearer $${env:TSUGA_API_KEY}
                endpoint: ${tsuga_intake_url}/v1/logs
    metrics:
      readers:
        - periodic:
            exporter:
              otlp:
                protocol: http/protobuf
                headers:
                  Authorization: Bearer $${env:TSUGA_API_KEY}
                endpoint: ${tsuga_intake_url}/v1/metrics
    traces:
      processors:
        - batch:
            exporter:
              otlp:
                protocol: http/protobuf
                headers:
                  Authorization: Bearer $${env:TSUGA_API_KEY}
                endpoint: ${tsuga_intake_url}/v1/traces
